# Public (safe to expose in the browser bundle)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
RESEND_API_KEY=
AI_MODEL=gpt-4o-mini

# Stripe Connect (booking payments). Businesses connect their own Stripe
# accounts; customers pay them directly. Webhook: a *Connect* endpoint at
# /api/stripe/webhook (see src/app/api/stripe/webhook/route.ts for events).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional One Place fee on each booking payment, in percent (default 0).
STRIPE_PLATFORM_FEE_PERCENT=0

# LiveKit (voice sessions)
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Next.js Server Actions encryption (set a stable value in production)
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
